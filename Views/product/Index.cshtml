@model List<ReuseMarket.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h1>ReuseMarket Products</h1>
<form asp-controller="Product" asp-action="Index" method="get" class="mb-4">

    <div class="row g-2">

        <div class="col-md-5">
            <input type="text"
                   name="searchString"
                   value="@Context.Request.Query["searchString"]"
                   class="form-control"
                   placeholder="Search for products..." />
        </div>

        <div class="col-md-4">
            <select name="category" class="form-select">
                <option value="">All Categories</option>
                <option value="Electronics">Electronics</option>
                <option value="Home and Furniture">Home and Furniture</option>
                <option value="Fashion">Fashion</option>
                <option value="Books and Education">Books and Education</option>
                <option value="General Goods">General Goods</option>
            </select>
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">
                Search
            </button>
        </div>

    </div>

</form>

<div class="container">
    @foreach (var product in Model)
    {
        <div class="card mb-3 p-3">

            @if (!string.IsNullOrEmpty(product.ImageUrl))
            {
                <img src="@product.ImageUrl"
                     alt="@product.Name"
                     class="product-image" />
            }

            <h3>@product.Name</h3>

            <p>@product.Description</p>

            <p><strong>Price:</strong> UGX @product.Price.ToString("N0")</p>

            <p><strong>Category:</strong> @product.Category</p>

            <p><strong>Location:</strong> @product.Location</p>
            <a asp-controller="Product"
   asp-action="Details"
   asp-route-id="@product.Id"
   class="btn btn-primary">
    View Details
</a>

        </div>
    }
</div>