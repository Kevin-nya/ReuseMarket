@model ReuseMarket.Models.Product

@{
ViewData["Title"] = "Product Details";
}

<div class="container mt-4">     <div class="row">
    <div class="col-md-6">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl"
                 alt="@Model.Name"
                 class="img-fluid rounded" />
        }
    </div>

    <div class="col-md-6">

        <h2>@Model.Name</h2>

        <h4 class="text-success">
            UGX @Model.Price.ToString("N0")
        </h4>

        <p>@Model.Description</p>

        <p><strong>Category:</strong> @Model.Category</p>

        <p><strong>Location:</strong> @Model.Location</p>

        <p>
            <strong>Date Posted:</strong>
            @Model.DatePosted.ToString("dd MMM yyyy")
        </p>

        <a asp-action="Index" class="btn btn-secondary">
            Back to Products
        </a>

        @if (User.Identity != null &&
             User.Identity.IsAuthenticated &&
             Model.SellerId == User.FindFirst(
                 System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
        {
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Edit Product
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-danger">
                Delete Product
            </a>
        }

        <!-- Seller Information -->
        <div class="card mt-4">
            <div class="card-body">

                <h5 class="card-title">Seller Information</h5>

                @if (Model.Seller != null)
                {
                    <p>
                        <strong>Seller:</strong>
                        @Model.Seller.FullName
                    </p>
                }
                else
                {
                    <p class="text-muted">
                        Seller information is not available.
                    </p>
                }

            </div>
        </div>

        <!-- Contact Seller -->
        @if (User.Identity != null &&
             User.Identity.IsAuthenticated &&
             Model.SellerId != null &&
             Model.SellerId != User.FindFirst(
                 System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
        {
            <div class="card mt-3">
                <div class="card-body">

                    <h5>Contact Seller</h5>

                    @if (TempData["MessageSuccess"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["MessageSuccess"]
                        </div>
                    }

                    @if (TempData["MessageError"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["MessageError"]
                        </div>
                    }

                    <form asp-controller="Message"
                          asp-action="Send"
                          method="post">

                        <input type="hidden"
                               name="productId"
                               value="@Model.Id" />

                        <div class="mb-3">
                            <textarea name="content"
                                      class="form-control"
                                      rows="4"
                                      maxlength="1000"
                                      placeholder="Write your message to the seller..."
                                      required></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            Send Message
                        </button>

                    </form>

                </div>
            </div>
        }

    </div>
</div>
</div>
