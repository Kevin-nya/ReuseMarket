@model List<ReuseMarket.Models.Message>

@{
    ViewData["Title"] = "My Inbox";
}

<div class="container mt-4">
    <h2>My Inbox</h2>
    <p class="text-muted">Messages sent to you by potential buyers.</p>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            You have no messages yet.
        </div>
    }
    else
    {
        @foreach (var message in Model)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5>
                        From: @(message.Sender?.FullName ?? "Unknown sender")
                    </h5>

                    <p>
                        <strong>Product:</strong>
                        @(message.Product?.Name ?? "Unknown product")
                    </p>

                    <p>@message.Content</p>

                    <small class="text-muted">
                        Received: @message.SentAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                    </small>

                    @if (!message.IsRead)
                    {
                        <span class="badge bg-primary ms-2">New</span>
                    }

                    <div class="mt-3">
                        <a asp-controller="Message"
                           asp-action="Conversation"
                           asp-route-productId="@message.ProductId"
                           asp-route-otherUserId="@message.SenderId"
                           class="btn btn-primary btn-sm">
                            View Conversation
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>