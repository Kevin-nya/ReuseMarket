@model List<ReuseMarket.Models.Message>

@{
ViewData["Title"] = "Conversation";
var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
var firstMessage = Model.FirstOrDefault();
var otherUserId = firstMessage == null ? null :
(firstMessage.SenderId == currentUserId
? firstMessage.ReceiverId
: firstMessage.SenderId);
}

<div class="container mt-4">     <h2>Conversation</h2>



@if (Model.Any())
{
    <h5>Product: @Model.First().Product?.Name</h5>

    <div class="card mt-3">
        <div class="card-body">

            @foreach (var message in Model)
            {
                bool isMine = message.SenderId == currentUserId;

                <div class="mb-3 text-@(isMine ? "end" : "start")">
                    <div class="d-inline-block p-3 rounded @(isMine ? "bg-primary text-white" : "bg-light")"
                         style="max-width: 75%;">

                        <strong>
                            @(isMine ? "You" : message.Sender?.FullName)
                        </strong>

                        <p class="mb-1">@message.Content</p>

                        <small>
                            @message.SentAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        </small>
                    </div>
                </div>
            }

        </div>
    </div>

    @if (TempData["ReplyError"] != null)
    {
        <div class="alert alert-danger mt-3">
            @TempData["ReplyError"]
        </div>
    }

    <form asp-action="Reply" method="post" class="mt-3">
        <input type="hidden" name="productId" value="@firstMessage.ProductId" />
        <input type="hidden" name="otherUserId" value="@otherUserId" />

        <div class="mb-3">
            <textarea name="content"
                      class="form-control"
                      rows="3"
                      maxlength="1000"
                      placeholder="Write your reply..."
                      required></textarea>
        </div>

        <button type="submit" class="btn btn-primary">
            Send Reply
        </button>
    </form>

    <a asp-action="Inbox" class="btn btn-secondary mt-3">
        Back to Inbox
    </a>
}
else
{
    <p>No messages found.</p>
}


</div>
